# Copie para .env e preencha conforme seu ambiente.

# Banco de dados PostgreSQL (ex: Supabase, Neon ou local)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# Segredo para assinatura de cookies de sessão (gere uma string aleatória)
SESSION_SECRET="sua_chave_secreta_longa_e_segura_aqui"

# Solana (Devnet ou Mainnet)
SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
# Secret key da carteira do app em base58 para assinar transações de Memo
APP_WALLET_SECRET_B58=""

# URL pública do app (usada para links de compartilhamento)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
